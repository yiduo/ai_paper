  "result_notes": {
    "thm:main": {
      "statement": "任意有界连通光滑三维域中，完整静态位移—牵引算子相等唯一确定两组实光滑Lamé系数。",
      "conditions": "μ>0、3λ+2μ>0于闭包；两者C∞延拓至闭包邻域；全边界全部位移数据，固定Euclidean坐标。",
      "limits": "无解析性／小梯度／先验边界邻域相等要求；不是有限传感、噪声稳定性、重建算法或各向异性定理。",
      "selected_grade": "B"
    },
    "lem:common-extension": {
      "statement": "相等全边界算子给全部边界jets，再构造共同外域且球外常值的可容许光滑延拓。",
      "conditions": "用Tan–Liu边界全阶判定；凸可容许集保严格能量正性；允许域补集有有界分量。",
      "limits": "不假定原系数事先在边界邻域相等；全jets不是有限噪声测量的可计算数据。",
      "selected_grade": "C"
    },
    "prop:physical-transfer": {
      "statement": "第一介质每个球内光滑物理解可传递至第二介质，位移及实际散度在域外相等。",
      "conditions": "同Dirichlet迹、同物理牵引和共同外域系数；界面弱拼接后强椭圆正则。",
      "limits": "不是把非单射辅助变量的任意Cauchy数据也识别为相等。",
      "selected_grade": "C"
    },
    "lem:augmented-system": {
      "statement": "物理L u=R(u,div u)，且对独立(u,d)恒有divR−S=P(divu−d)，规范后主部ΔId4。",
      "conditions": "m=μ,k=λ+μ,ell=λ+2μ正；光滑坐标导数可交换；P=mΔ+∇m·∇。",
      "limits": "R=S=0只给缺陷P(divu−d)=0，缺少额外约束不能推d=divu；不同介质规范算子差仅一阶。",
      "selected_grade": "C"
    },
    "prop:carleman": {
      "statement": "紧支撑四分量增强系统满足加权Hh1≤Ch加权Hh−1强迫界。",
      "conditions": "固定球／系数／非零复零向量θ，h=1/τ充分小；先定ε吸收再定h。",
      "limits": "C和阈值未可计算；固定凸化权重乘子移除后不再次吸收；复点积双线性，范数Hermitian。",
      "selected_grade": "C"
    },
    "cor:physical-solvability": {
      "statement": "物理共轭算子有L2测试界及任意L2强迫的分布解，解范数≤C强迫。",
      "conditions": "使用实际散度并抵消h损失；形式自伴算子配对−共轭θ；Hahn–Banach对偶。",
      "limits": "只在球内分布解且非边值重建算法；未知C不是1。",
      "selected_grade": "C"
    },
    "lem:scaled-interior": {
      "statement": "共轭物理解在内球有Σj≤2 h^j||∇^jz||≤C(||z||+h²||f||)。",
      "conditions": "B紧含B；h尺度重缩放保持强椭圆及系数族紧性；每个固定τ光滑。",
      "limits": "常数依赖域间距、系数／导数界和方向；非所有τ统一无条件误差条。",
      "selected_grade": "C"
    },
    "lem:planar-frames": {
      "statement": "平面矩阵dbar系统有可逆光滑框架，局部横向参数光滑，并有保横向支撑的非齐次解。",
      "conditions": "圆盘Stein且可缩；先局部Neumann小盘再Oka/Grauert拼接；参数局部邻域。",
      "limits": "不保证可指定任意初值或无穷远归一化为Id；框架本身不唯一。",
      "selected_grade": "C"
    },
    "prop:physical-amplitudes": {
      "statement": "约束三维运输纤维的局部三框架可由实际弹性解及其真实散度强L2实现，权一阶导O(τ)。",
      "conditions": "N≥4兼容递推，normal约束θ·a_j=−(diva_j−1−b_j−1)，物理残差O(τ^(1−N))。",
      "limits": "散度校正损失一阶为O(τ^(2−N))；只校正物理位移方程，不能任意辅助解代替。",
      "selected_grade": "C"
    },
    "lem:transport-normal-form": {
      "statement": "正系数可逆变换把约束运输化为上块通用Dp=θs、下块Qθ·p+Tθs。",
      "conditions": "Eθ=θ正交平面⊕C，维数3；p=√μa，s=−(λ+μ)b/(2√μ)−∇logμ·p/2。",
      "limits": "Qθ是对p的协向量，θ点积双线性而非Hermitian；θ依赖线性／全纯。",
      "selected_grade": "C"
    },
    "lem:supported-transport": {
      "statement": "紧支撑平面齐次运输唯一为零，固定支撑Sobolev空间有下界；稠密参数存在延为每参数唯一光滑解。",
      "conditions": "γ(ρ)非零，A光滑；固定较小支撑圆盘和较大算子域；T=(P*P)^−1P*。",
      "limits": "只构造左逆不要求对全部目标空间满射；参数求导须固定Hilbert内积／支撑空间。",
      "selected_grade": "C"
    },
    "prop:transport-matching": {
      "statement": "由物理传递弱极限得唯一紧支撑比较G，方向投影不变并在固定x全纯。",
      "conditions": "仅第一介质框架Y1须可逆；Y2初仅L2；逐固定方向先取子列，再靠唯一性拼接方向。",
      "limits": "非先指定任意辅助边界数据；移动坐标只证光滑，bar方向导数必须回固定物理x再算。",
      "selected_grade": "C"
    },
    "lem:conic-bundle": {
      "statement": "零锥方向上的H≅O(−1)²、N≅O(−2)，商H/N平凡且H无非零全局全纯截面。",
      "conditions": "复投影零二次曲线C≅CP1；显式齐次θ,h1,h2覆盖两图端点。",
      "limits": "短正合列不全纯分裂；H自身仍有非标量全纯自同态，不能仅靠无截面就称全部自同态标量。",
      "selected_grade": "C"
    },
    "prop:comparison-rigidity": {
      "statement": "运输比较G必为Id，因而两限制运输在Eθ上相等。",
      "conditions": "无H截面消上右块，商线束消F−fId；上块秩≤1对dimH=2强迫Df=0；外域值定f=1。",
      "limits": "保留运输结构及维数；不能搬到任意秩／任意参数空间的规范变换。",
      "selected_grade": "C"
    },
    "lem:finite-type": {
      "statement": "Hessianη=B∇η+qId自动闭为(∇η,q)齐次一阶系统，非空开集零值沿路径传播至连通域。",
      "conditions": "n≥2，B光滑已给；每s选择i≠s且不求和，交换三阶导。",
      "limits": "不是噪声稳定常数或重建；完成主定理中B本身由两未知系数对决定，不能当已知反演输入。",
      "selected_grade": "C"
    }
  },
