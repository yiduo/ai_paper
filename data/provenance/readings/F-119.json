  "result_notes": {
    "S::main:soft": {
      "statement": "固定初始信息的随机二元通道经均匀独立比特BSC后，I(Tρu)≤ψ(|ρ|ψ^-1(I(u)))，软坐标等号。",
      "conditions": "任意有限n含0，u∈[-1,1]；输入均匀独立，噪声对称独立；自然对数，ρ∈[-1,1]。",
      "constants_and_limits": "更早Chen2026 Lemma9.2的F分支已可推出相同曲线；不是新数值预算增益，也不覆盖非均匀／相关输入。",
      "selected_grade": "B"
    },
    "S::main:ck": {
      "statement": "Boolean摘要按输出均值m细化为ψ(|ρ|ψ^-1(H(m)))，再≤ψ(|ρ|)；非零非退化偏置时前者严格小。",
      "conditions": "Boolean值±1、均匀独立输入与BSC；输出偏置不等于输入偏置，严格性需0<|m|<1与|ρ|>0。",
      "constants_and_limits": "有偏Boolean未必达到细化曲线；不能把“全噪声向量”换成对方已压缩的一比特观察。",
      "selected_grade": "B"
    },
    "S::upgrade:production": {
      "statement": "内点软场的信息生产率D≥max(B_m(I),F(I))≥F(I)。",
      "conditions": "u所有值严格在(-1,1)，N=1/2Σ(Id−flip)，D=E[atanh(u)Nu]；I=H(m)−EH(u)。",
      "constants_and_limits": "B_m=2I+(1−m²)S(L−(H(m)−I)/(1−m²))；S负参零延拓仅C1。该速率不是有限t收缩曲线，需另积分并控制数值误差。",
      "selected_grade": "B"
    },
    "S::scalar:entropy-bounds": {
      "statement": "熵缺口满足r²/2≤ψ(r)≤Lr²，H(r)≥L(1−r²)，并给L与M=4L²/3的有理界。",
      "conditions": "|r|≤1，L=ln2，0log0=0；ψ(r)/r²在正区间严格增。",
      "constants_and_limits": "这些是证明中的经典标量输入；H为二元熵，不是另一手稿的平方根函数。",
      "selected_grade": "C"
    },
    "S::scalar:profile-convexity": {
      "statement": "F光滑凸，F′(0)=2、F″≥4/3、F‴≥0；S=F−2I零延拓非负单调凸且C1。",
      "conditions": "F(ψ(r))=r atanh(r)，0≤I<L。",
      "constants_and_limits": "S在0的二阶导跳跃；不得按全局C2跨接缝微分。F在L没有有限端点值。",
      "selected_grade": "C"
    },
    "S::scalar:curvature-growth": {
      "statement": "e^-2I F″(I)严格递增，I>0时F‴/F″>2。",
      "conditions": "0≤I<L；用正双曲积分表达式及连续延拓。",
      "constants_and_limits": "只用于规定熵区间的斜率比较，不是任意散度轮廓的通用性质。",
      "selected_grade": "C"
    },
    "S::scalar:scaled-curvature": {
      "statement": "缩放曲率P(h)=h²F″(L−h)介于1/2和4L²/3。",
      "conditions": "0<h≤L；证明将熵写作正矩积分并比较协方差。",
      "constants_and_limits": "尾端h=0不取值；常数不依赖维度但仅该熵／速率规范适用。",
      "selected_grade": "C"
    },
    "S::canonical:priced": {
      "statement": "固定两个均值的熵定价连接问题有唯一最优：一个有序内点核加两个可能的共同输出角。",
      "conditions": "-1<b<a<1，价格p≥0；连接代价边界只在同角为零，其余边界无穷。",
      "constants_and_limits": "在一份平均熵预算下作松弛；非任意给定两个单独熵矩的替换定理。",
      "selected_grade": "C"
    },
    "S::canonical:coverage": {
      "statement": "每个0<e≤最大平均熵都由三点定价最优律达到，并且实际平均熵恰为e。",
      "conditions": "均值固定且非同值；价格连续、p→∞熵趋零，非负价格保证≤e约束方向。",
      "constants_and_limits": "同均值差为0时成本直接为0；两角／一角阈值与生产率半信息阈值不同。",
      "selected_grade": "C"
    },
    "S::capacity:onebit": {
      "statement": "有偏单比特通道的生产率D≥αF(J/α)，且J<αL，α=1−m²。",
      "conditions": "g=m+δX，X公平，|m|+|δ|<1；后验的大小偏置信息权重。",
      "constants_and_limits": "不是一般高维场的直接一比特分解；Kramer–Saglam同相关一比特比较的导数已给该机制。",
      "selected_grade": "C"
    },
    "S::reserve:geometry": {
      "statement": "共同输出角几何满足(1−m)²log(α/β)≤3κ。",
      "conditions": "|m|<1，0≤δ<1−|m|，α=1−m²、β=α−δ²、κ=−log(1−δ²/(1+m)²)/2。",
      "constants_and_limits": "对数有合法正分母；不把零δ除去后遗忘退化情形。",
      "selected_grade": "C"
